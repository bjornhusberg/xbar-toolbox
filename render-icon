#!/bin/bash
# Generates the composite toolbar icon and prints base64 PNG to stdout.
# Usage: render-icon <amph_active> <battery_state: none|battery-N|charging-N> <wifi_state> <audio_state> <copilot_pct> [github] [teams: none|away|unread|awayunread]
# copilot_pct: daily Copilot usage percentage; the donut is drawn when > 0.

CONFIG_DIR="$(cd "$(dirname "$0")" && pwd)"
CACHE_DIR="$CONFIG_DIR/cache"

amph_active="$1"
battery_state="$2"
wifi_state="$3"
audio_state="$4"
copilot_pct="${5:-0}"
github_active="$6"
teams_state="${7:-none}"

swift - <<SWIFT 2>/dev/null
import AppKit

let cacheDir = "$CACHE_DIR"
let amphetamineActive = $([[ "$amph_active" == "true" ]] && echo "true" || echo "false")
let batteryState = "$battery_state"
let wifiState = "$wifi_state"
let audioState = "$audio_state"
let copilotPct: Double = $copilot_pct
let githubActive = $([[ "$github_active" == "true" ]] && echo "true" || echo "false")
let teamsState = "$teams_state"
let isDark = UserDefaults.standard.string(forKey: "AppleInterfaceStyle") == "Dark"
let iconColor = isDark ? NSColor.white : NSColor.black
let disabledColor = isDark ? NSColor(red: 0.7, green: 0.7, blue: 0.7, alpha: 0.8) :
    NSColor(red: 0.3, green: 0.3, blue: 0.3, alpha: 0.8)

// Base icons are SF Symbols, drawn on first use and kept in the cache folder as icon-<name>.b64.
let symbolSpecs: [String: (symbol: String, pointSize: CGFloat)] = [
    "awake": ("eye.fill", 16),
    "teams": ("person.bubble.fill", 14),
    "wifi": ("wifi", 14),
    "hotspot": ("personalhotspot", 13),
    "audio-speaker": ("speaker.wave.2.fill", 13),
    "audio-headphones": ("headphones", 13),
]

// Brand logos are not SF Symbols, so they are drawn from SVG (size in points).
let svgIcons: [String: (svg: String, size: Int)] = [
    "github": (#"<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"><path fill="black" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>"#, 17),
]

func drawSymbol(_ name: String) -> Data {
    let img: NSImage
    let w: Int, h: Int
    if let logo = svgIcons[name] {
        img = NSImage(data: Data(logo.svg.utf8))!
        w = logo.size; h = logo.size
    } else {
        let spec = symbolSpecs[name]!
        let cfg = NSImage.SymbolConfiguration(pointSize: spec.pointSize, weight: .regular)
        img = NSImage(systemSymbolName: spec.symbol, accessibilityDescription: nil)!.withSymbolConfiguration(cfg)!
        w = Int(ceil(img.size.width)); h = Int(ceil(img.size.height))
    }
    let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: w * 2, pixelsHigh: h * 2, bitsPerSample: 8,
                               samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
                               colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
    rep.size = NSSize(width: w, height: h)
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
    img.draw(in: NSRect(x: 0, y: 0, width: w, height: h))
    NSGraphicsContext.restoreGraphicsState()
    return rep.representation(using: .png, properties: [:])!
}

func loadIcon(_ name: String) -> NSBitmapImageRep {
    let path = "\(cacheDir)/icon-\(name).b64"
    if let b64 = try? String(contentsOfFile: path, encoding: .utf8),
       let data = Data(base64Encoded: b64.trimmingCharacters(in: .whitespacesAndNewlines)),
       let rep = NSBitmapImageRep(data: data) {
        return rep
    }
    let png = drawSymbol(name)
    try? png.base64EncodedString().write(toFile: path, atomically: true, encoding: .utf8)
    return NSBitmapImageRep(data: png)!
}

func recolor(_ bmp: NSBitmapImageRep, to color: NSColor) {
    let rgb = color.usingColorSpace(.deviceRGB)!
    var r: CGFloat = 0, g: CGFloat = 0, b: CGFloat = 0
    rgb.getRed(&r, green: &g, blue: &b, alpha: nil)
    guard let data = bmp.bitmapData else { return }
    let stride = bmp.bytesPerRow
    for y in 0..<bmp.pixelsHigh {
        for x in 0..<bmp.pixelsWide {
            let o = y * stride + x * 4
            if data[o + 3] > 0 {
                data[o]     = UInt8(r * 255)
                data[o + 1] = UInt8(g * 255)
                data[o + 2] = UInt8(b * 255)
            }
        }
    }
}

let canvasH = 36

var awake: NSBitmapImageRep? = nil
var awakeW = 0
if amphetamineActive {
    awake = loadIcon("awake")
    awakeW = awake?.pixelsWide ?? 0
}

var wifi: NSBitmapImageRep? = nil
var wifiW = 0
if wifiState == "disconnected" {
    wifi = loadIcon("wifi")
    wifiW = wifi?.pixelsWide ?? 0
} else if wifiState == "hotspot" {
    wifi = loadIcon("hotspot")
    wifiW = wifi?.pixelsWide ?? 0
}

var audio: NSBitmapImageRep? = nil
var audioW = 0
if audioState != "none" {
    audio = loadIcon("audio-\(audioState)")
    audioW = audio?.pixelsWide ?? 0
}

let copilotW = copilotPct > 0 ? 36 : 0

var github: NSBitmapImageRep? = nil
var githubW = 0
if githubActive {
    github = loadIcon("github")
    githubW = (github?.pixelsWide ?? 0) + 10  // room for the badge
}

var teams: NSBitmapImageRep? = nil
var teamsW = 0
let teamsAway = teamsState.contains("away")
let teamsUnread = teamsState.contains("unread")
if teamsAway || teamsUnread {
    teams = loadIcon("teams")
    teamsW = (teams?.pixelsWide ?? 0) + (teamsUnread ? 10 : 0)  // room for the unread badge
}

// The battery only shows below 75% on battery power, or when nothing else is showing.
let batteryLevel = Int(batteryState.split(separator: "-").last ?? "0") ?? 0
let lowOnBattery = batteryState.hasPrefix("battery-") && batteryLevel < 75
let otherIcons = awakeW > 0 || wifiW > 0 || audioW > 0 || copilotW > 0 || githubW > 0 || teamsW > 0
let batteryW = (batteryState != "none" && (lowOnBattery || !otherIcons)) ? 51 : 0
let gap = 32
var totalW = 0
func addW(_ w: Int) { if w > 0 { totalW += (totalW > 0 ? gap : 0) + w } }
// The battery is the leftmost icon
addW(batteryW); addW(awakeW); addW(wifiW); addW(audioW); addW(copilotW); addW(githubW); addW(teamsW)
if totalW == 0 { totalW = 2 }  // nothing to show (no battery): a blank image instead of a crash

let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: totalW, pixelsHigh: canvasH, bitsPerSample: 8,
                           samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
                           colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
rep.size = NSSize(width: Double(totalW) / 2, height: Double(canvasH) / 2)

NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
let scale = NSAffineTransform(); scale.scale(by: 0.5); scale.concat()

func drawBadge(_ rect: NSRect, fill: NSColor, border: NSColor) {
    let path = NSBezierPath(ovalIn: rect.insetBy(dx: 1, dy: 1))
    fill.setFill()
    path.fill()
    border.setStroke()
    path.lineWidth = 2
    path.stroke()
}

var xPos = 0

if batteryW > 0 {
    let level = batteryLevel
    let charging = batteryState.hasPrefix("charging")
    let batH = 24, by = (canvasH - batH) / 2
    iconColor.setStroke(); iconColor.setFill()
    let body = NSRect(x: xPos + 1, y: by + 1, width: 44, height: 22)
    let outline = NSBezierPath(roundedRect: body, xRadius: 6, yRadius: 6)
    outline.lineWidth = 2
    outline.stroke()
    NSBezierPath(roundedRect: NSRect(x: xPos + 47, y: by + 8, width: 4, height: 8), xRadius: 2, yRadius: 2).fill()
    let fillW = Int(36.0 * Double(level) / 100)
    if fillW > 0 {
        NSBezierPath(roundedRect: NSRect(x: xPos + 5, y: by + 5, width: max(fillW, 3), height: 14), xRadius: 2, yRadius: 2).fill()
    }
    if charging {
        let cx = Double(xPos) + 23, cy = Double(by) + 12
        let bolt = NSBezierPath()
        bolt.move(to: NSPoint(x: cx + 1.5, y: cy + 7.5))
        bolt.line(to: NSPoint(x: cx - 4.5, y: cy - 0.5))
        bolt.line(to: NSPoint(x: cx - 0.5, y: cy - 0.5))
        bolt.line(to: NSPoint(x: cx - 1.5, y: cy - 7.5))
        bolt.line(to: NSPoint(x: cx + 4.5, y: cy + 0.5))
        bolt.line(to: NSPoint(x: cx + 0.5, y: cy + 0.5))
        bolt.close()
        // Solid bolt: a hole where the fill is behind it, the icon colour where the battery is empty.
        NSGraphicsContext.current?.compositingOperation = .clear
        bolt.fill()
        NSGraphicsContext.current?.compositingOperation = .sourceOver
        NSGraphicsContext.saveGraphicsState()
        let fillRect = NSRect(x: xPos + 5, y: by + 5, width: fillW > 0 ? max(fillW, 3) : 0, height: 14)
        let outsideFill = NSBezierPath(rect: NSRect(x: cx - 20, y: cy - 20, width: 40, height: 40))
        outsideFill.appendRect(fillRect)
        outsideFill.windingRule = .evenOdd
        outsideFill.setClip()
        iconColor.setFill()
        bolt.fill()
        NSGraphicsContext.restoreGraphicsState()
    }
    xPos += batteryW
}

if let awake = awake, awakeW > 0 {
    if xPos > 0 { xPos += gap }
    recolor(awake, to: iconColor)
    let awakeY = (canvasH - awake.pixelsHigh) / 2
    awake.draw(in: NSRect(x: xPos, y: awakeY, width: awake.pixelsWide, height: awake.pixelsHigh))
    xPos += awakeW
}

if let wifi = wifi, wifiW > 0 {
    if xPos > 0 { xPos += gap }
    recolor(wifi, to: wifiState == "hotspot" ? iconColor : disabledColor)
    let wifiY = (canvasH - wifi.pixelsHigh) / 2
    wifi.draw(in: NSRect(x: xPos, y: wifiY, width: wifi.pixelsWide, height: wifi.pixelsHigh))
    xPos += wifiW
}

if let audio = audio, audioW > 0 {
    if xPos > 0 { xPos += gap }
    recolor(audio, to: iconColor)
    let audioY = (canvasH - audio.pixelsHigh) / 2
    audio.draw(in: NSRect(x: xPos, y: audioY, width: audio.pixelsWide, height: audio.pixelsHigh))
    xPos += audioW
}

if copilotW > 0 {
    if xPos > 0 { xPos += gap }
    let clamped = min(100.0, copilotPct)
    let normalColor: NSColor = isDark ? .white : NSColor(srgbRed: 30/255, green: 30/255, blue: 30/255, alpha: 1)
    let revealedColor: NSColor = {
        guard clamped > 75 else { return NSColor(srgbRed: 144/255, green: 152/255, blue: 158/255, alpha: 1) }
        let t = CGFloat((clamped - 75) / 25)
        return NSColor(srgbRed: (144 + (197-144)*t)/255,
                       green:   (152 + (17-152)*t)/255,
                       blue:    (158 + (30-158)*t)/255, alpha: 1)
    }()
    let center = NSPoint(x: Double(xPos) + 18, y: Double(canvasH) / 2)
    let outerR: CGFloat = 16, innerR: CGFloat = 8
    func donutPath() -> NSBezierPath {
        let p = NSBezierPath(); p.windingRule = .evenOdd
        p.appendArc(withCenter: center, radius: outerR, startAngle: 0, endAngle: 360)
        p.appendArc(withCenter: center, radius: innerR, startAngle: 0, endAngle: 360)
        return p
    }
    normalColor.setFill(); donutPath().fill()
    NSGraphicsContext.saveGraphicsState()
    donutPath().setClip()
    revealedColor.setFill()
    let wedge = NSBezierPath()
    wedge.move(to: center)
    wedge.appendArc(withCenter: center, radius: outerR + 1, startAngle: 90,
                    endAngle: 90 - CGFloat(clamped / 100.0 * 360.0), clockwise: true)
    wedge.close(); wedge.fill()
    NSGraphicsContext.restoreGraphicsState()
    xPos += copilotW
}

let redBadge = (fill: NSColor(red: 230/255, green: 40/255, blue: 40/255, alpha: 1),
                border: NSColor(red: 140/255, green: 15/255, blue: 15/255, alpha: 1))
let amberBadge = (fill: NSColor(red: 240/255, green: 170/255, blue: 20/255, alpha: 1),
                  border: NSColor(red: 140/255, green: 90/255, blue: 0, alpha: 1))

// Draws a recolored icon at x with a badge on its top-right corner.
func drawBadgedIcon(_ icon: NSBitmapImageRep, at x: Int, tint: NSColor? = nil, badge: (fill: NSColor, border: NSColor)?) {
    recolor(icon, to: tint ?? iconColor)
    let y = (canvasH - icon.pixelsHigh) / 2
    icon.draw(in: NSRect(x: x, y: y, width: icon.pixelsWide, height: icon.pixelsHigh))
    guard let badge = badge else { return }
    let r = 8.0
    drawBadge(NSRect(x: Double(x + icon.pixelsWide) - 6, y: Double(canvasH) - 2 * r - 1, width: 2 * r, height: 2 * r),
              fill: badge.fill, border: badge.border)
}

if let github = github, githubW > 0 {
    if xPos > 0 { xPos += gap }
    drawBadgedIcon(github, at: xPos, badge: amberBadge)
    xPos += githubW
}

if let teams = teams, teamsW > 0 {
    if xPos > 0 { xPos += gap }
    drawBadgedIcon(teams, at: xPos, tint: teamsAway ? disabledColor : nil, badge: teamsUnread ? amberBadge : nil)
    xPos += teamsW
}

NSGraphicsContext.restoreGraphicsState()
print(rep.representation(using: .png, properties: [:])!.base64EncodedString())
SWIFT
